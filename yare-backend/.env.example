# Database
DATABASE_URL=postgres://user:password@localhost:5432/yare?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub Token Encryption
GITHUB_TOKEN_ENCRYPTION_KEY=32-byte-hex-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (Email)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yare.jp

# Agreement Hash Chain
AGREEMENT_SALT=your-secret-salt-here

# App
APP_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# Sentry
SENTRY_DSN=
